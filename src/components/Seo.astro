---
import { LOCALES, SITE, safeJson, withBase, type Locale } from '../lib/site';
import { HTML_LANG, OG_LOCALE, switchLocalePath } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  locale?: Locale;
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  noIndex = false,
  locale = 'en',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? withBase('/og-default.png'), Astro.site);
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  description: SITE.description,
  url: Astro.site,
  telephone: SITE.phone,
  email: SITE.email,
  address: { '@type': 'PostalAddress', streetAddress: SITE.address, addressCountry: 'VN' },
  sameAs: Object.values(SITE.social),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noIndex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="max-image-preview:large" />}
{!noIndex && <link rel="canonical" href={canonical} />}

{!noIndex &&
  LOCALES.map((l) => (
    <link
      rel="alternate"
      hreflang={HTML_LANG[l]}
      href={new URL(switchLocalePath(Astro.url, l), Astro.site)}
    />
  ))}
{!noIndex && (
  <link
    rel="alternate"
    hreflang="x-default"
    href={new URL(switchLocalePath(Astro.url, 'en'), Astro.site)}
  />
)}

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} — Journal`}
  href={new URL(withBase('/rss.xml'), Astro.site)}
/>

<meta property="og:type" content={type} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
<meta property="og:locale:alternate" content={OG_LOCALE[locale === 'vi' ? 'en' : 'vi']} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<script type="application/ld+json" set:html={safeJson(orgSchema)} />
