---
import { SITE, withBase, type Locale } from '../lib/site';
import { switchLocalePath, UI } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = UI[locale];

const links = [
  { href: withBase('/projects/'), label: t.nav.projects },
  { href: withBase('/about/'), label: t.nav.studio },
  { href: withBase('/journal/'), label: t.nav.journal },
  { href: withBase('/contact/'), label: t.nav.contact },
];

const path = Astro.url.pathname;
const homeHref = withBase('/');
const isActive = (href: string) =>
  href === homeHref ? path === homeHref : path.startsWith(href.replace(/\/$/, ''));

// Language toggle: same page in the other locale (query string preserved).
const other: Locale = locale === 'vi' ? 'en' : 'vi';
const switchHref = switchLocalePath(Astro.url, other);
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-ink-900/5 bg-cream-50/90 backdrop-blur-md"
>
  <div class="container-x flex h-16 items-center justify-between gap-6 lg:h-20">
    <a href={homeHref} class="flex items-baseline gap-2" aria-label={`${SITE.name} — home`}>
      <span class="font-display text-2xl font-semibold tracking-tight text-ink-900">
        FORMA<span class="text-clay-600">.</span>
      </span>
      <span class="hidden text-[11px] font-medium tracking-[0.18em] text-ink-500 uppercase sm:inline">
        {SITE.tagline}
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-clay-600',
              isActive(link.href) ? 'text-clay-600' : 'text-ink-700',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href={withBase('/contact/')} class="btn-primary px-5! py-2.5!">{t.nav.startProject}</a>
      <nav class="flex items-center gap-1 rounded-full border border-ink-900/10 p-0.5 text-xs font-semibold" aria-label={t.nav.language}>
        <a
          href={switchLocalePath(Astro.url, 'en')}
          hreflang="en"
          class:list={['rounded-full px-2 py-1 transition-colors', locale === 'en' ? 'bg-ink-900 text-cream-50' : 'text-ink-600 hover:text-ink-900']}
          aria-current={locale === 'en' ? 'true' : undefined}
        >EN</a>
        <a
          href={switchHref}
          hreflang="vi"
          class:list={['rounded-full px-2 py-1 transition-colors', locale === 'vi' ? 'bg-ink-900 text-cream-50' : 'text-ink-600 hover:text-ink-900']}
          aria-current={locale === 'vi' ? 'true' : undefined}
        >VI</a>
      </nav>
    </nav>

    <button
      id="menu-toggle"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.nav.toggleMenu}
    >
      <span class="h-0.5 w-6 rounded bg-ink-900 transition-transform"></span>
      <span class="h-0.5 w-6 rounded bg-ink-900 transition-opacity"></span>
      <span class="h-0.5 w-6 rounded bg-ink-900 transition-transform"></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-ink-900/5 bg-cream-50 px-5 py-4 md:hidden"
    aria-label="Mobile"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="block border-b border-ink-900/5 py-3 text-base font-medium text-ink-800"
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a href={withBase('/contact/')} class="btn-primary mt-4 w-full">{t.nav.startProject}</a>
    <nav class="mt-3 flex items-center gap-2 text-sm" aria-label={t.nav.language}>
      <a
        href={switchLocalePath(Astro.url, 'en')}
        hreflang="en"
        class:list={['font-semibold', locale === 'en' ? 'text-ink-900 underline underline-offset-4' : 'text-ink-500']}
        aria-current={locale === 'en' ? 'true' : undefined}
      >English</a>
      <span aria-hidden="true" class="text-ink-900/25">·</span>
      <a
        href={switchHref}
        hreflang="vi"
        class:list={['font-semibold', locale === 'vi' ? 'text-ink-900 underline underline-offset-4' : 'text-ink-500']}
        aria-current={locale === 'vi' ? 'true' : undefined}
      >Tiếng Việt</a>
    </nav>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
