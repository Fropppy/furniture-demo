---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Placeholder from '../Placeholder.astro';
import ProjectCard from '../ProjectCard.astro';
import { placeholderDataUri } from '../../lib/placeholders';
import { CATEGORIES, SITE, safeJson, withBase, type Locale } from '../../lib/site';
import { pick } from '../../lib/i18n';
import { HTML_LANG, UI } from '../../lib/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
  related: CollectionEntry<'projects'>[];
  locale: Locale;
}

const { project, prev, next, related, locale } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const t = UI[locale];
const prefix = locale === 'vi' ? '/vi' : '';

// EN is the source of truth; VI fields fall back per-field.
const title = pick(locale, data.title, data.titleVi);
const summary = pick(locale, data.summary, data.summaryVi);
const location = pick(locale, data.location, data.locationVi);
const budget = pick(locale, data.budget, data.budgetVi);
const services = locale === 'vi' && data.servicesVi?.length ? data.servicesVi : data.services;

// Real photography wins when present; otherwise fall back to the generated
// scene illustrations (ADR 0005) so a project is never left imageless.
const photos = data.photos ?? [];
let uidCounter = 0;
const galleryItems = data.gallery.map((scene) => ({
  scene,
  uri: placeholderDataUri(scene, data.hue, `d${++uidCounter}`),
}));

const meta = [
  [t.project.metaLabels.client, data.client],
  [t.project.metaLabels.location, location],
  [t.project.metaLabels.area, `${data.area} m²`],
  [t.project.metaLabels.style, data.style],
  [t.project.metaLabels.year, String(data.year)],
  [t.project.metaLabels.services, services.join(', ')],
  ...(budget ? [[t.project.metaLabels.investment, budget]] : []),
] as [string, string][];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.project.breadcrumbHome, item: new URL(withBase(`${prefix}/`), Astro.site) },
    { '@type': 'ListItem', position: 2, name: t.project.breadcrumbProjects, item: new URL(withBase(`${prefix}/projects/`), Astro.site) },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const workSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  name: title,
  description: summary,
  inLanguage: HTML_LANG[locale],
  datePublished: String(data.year),
  locationCreated: location,
  author: { '@type': 'Organization', name: SITE.name },
};
---

<Base title={locale === 'vi' && data.seoTitleVi?.trim() ? data.seoTitleVi : data.seoTitle ?? title} description={data.seoDescription ?? summary} {locale}>
  <script type="application/ld+json" set:html={safeJson(breadcrumb)} slot="seo" />
  <script type="application/ld+json" set:html={safeJson(workSchema)} slot="seo" />

  <article class="py-12 lg:py-16">
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={withBase(`${prefix}/`)} class="hover:text-clay-600">{t.project.breadcrumbHome}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={withBase(`${prefix}/projects/`)} class="hover:text-clay-600">{t.project.breadcrumbProjects}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-800">{title}</li>
        </ol>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[2fr_1fr] lg:items-end">
        <div>
          <p class="eyebrow reveal">
            {CATEGORIES[data.category][locale]} · {data.year}
          </p>
          <h1 class="reveal mt-3 font-display text-4xl text-ink-900 sm:text-5xl lg:text-6xl">
            {title}
          </h1>
          <p class="reveal mt-5 max-w-2xl text-lg text-ink-600">{summary}</p>
        </div>
        <dl class="reveal grid grid-cols-2 gap-x-6 gap-y-4 border-t border-ink-900/10 pt-6 text-sm lg:border-t-0 lg:pt-0">
          {
            meta.map(([label, value]) => (
              <div>
                <dt class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">
                  {label}
                </dt>
                <dd class="mt-1 text-ink-800">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Cover photo (falls back to the gallery below when absent) -->
      {
        data.cover && (
          <figure class="mt-12 overflow-hidden rounded-xl bg-cream-100">
            <Image
              src={data.cover.image}
              alt={data.cover.alt}
              layout="full-width"
              priority
              class="w-full"
            />
            {data.cover.caption && (
              <figcaption class="px-4 py-3 text-center text-sm text-ink-500 sm:px-6">
                {data.cover.caption}
              </figcaption>
            )}
          </figure>
        )
      }

      <!-- Photo gallery -->
      <section class="mt-14" aria-label={t.project.galleryAria}>
        {
          photos.length > 0 ? (
            <div class="pswp-gallery grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
              {photos.map((photo, i) => (
                <a
                  href={photo.image.src}
                  class:list={[
                    'group block overflow-hidden rounded-xl bg-cream-100',
                    i % 5 === 0 ? 'lg:col-span-2 lg:row-span-2' : '',
                  ]}
                  data-pswp-width={photo.image.width}
                  data-pswp-height={photo.image.height}
                  aria-label={t.project.photoAriaTemplate.replace('{i}', String(i + 1)).replace('{title}', title)}
                >
                  <div class:list={[
                    'overflow-hidden',
                    i % 5 === 0 ? 'aspect-square lg:aspect-auto lg:h-full' : 'aspect-[4/3]',
                  ]}>
                    <Image
                      src={photo.image}
                      alt={photo.alt}
                      width={800}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                    />
                  </div>
                  {photo.caption && (
                    <p class="mt-2 text-sm text-ink-500">{photo.caption}</p>
                  )}
                </a>
              ))}
            </div>
          ) : (
            <div class="pswp-gallery grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
              {galleryItems.map((item, i) => (
                <a
                  href={item.uri}
                  class:list={[
                    'group block overflow-hidden rounded-xl bg-cream-100',
                    i % 5 === 0 ? 'lg:col-span-2 lg:row-span-2' : '',
                  ]}
                  data-pswp-width="1600"
                  data-pswp-height="1200"
                  aria-label={t.project.photoAriaTemplate.replace('{i}', String(i + 1)).replace('{title}', title)}
                >
                  <div class:list={['overflow-hidden', i % 5 === 0 ? 'aspect-square lg:aspect-auto lg:h-full' : 'aspect-[4/3]']}>
                    <Placeholder
                      scene={item.scene}
                      hue={data.hue}
                      alt={t.project.photoAltTemplate.replace('{title}', title).replace('{i}', String(i + 1))}
                      class="h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                    />
                  </div>
                </a>
              ))}
            </div>
          )
        }
        {
          photos.length === 0 && (
            <p class="mt-4 text-center text-xs text-ink-500">{t.project.placeholderNote}</p>
          )
        }
      </section>

      <!-- Write-up -->
      <div class="mx-auto mt-16 max-w-3xl">
        <div class="prose-brand">
          <Content />
        </div>
      </div>

      <!-- Prev / next -->
      <nav class="mt-20 grid gap-4 border-t border-ink-900/10 pt-8 sm:grid-cols-2" aria-label={t.project.breadcrumbProjects}>
        {
          prev ? (
              <a href={withBase(`${prefix}/projects/${prev.id}/`)} class="group">
              <p class="text-xs tracking-[0.18em] text-ink-500 uppercase">{t.project.prev}</p>
              <p class="mt-1 font-display text-xl text-ink-900 group-hover:text-clay-600">
                {pick(locale, prev.data.title, prev.data.titleVi)}
              </p>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={withBase(`${prefix}/projects/${next.id}/`)} class="group sm:text-right">
              <p class="text-xs tracking-[0.18em] text-ink-500 uppercase">{t.project.next}</p>
              <p class="mt-1 font-display text-xl text-ink-900 group-hover:text-clay-600">
                {pick(locale, next.data.title, next.data.titleVi)}
              </p>
            </a>
          )
        }
      </nav>
    </div>
  </article>

  <!-- Related -->
  {
    related.length > 0 && (
      <section class="bg-cream-100 py-16 lg:py-20">
        <div class="container-x">
          <h2 class="font-display text-2xl text-ink-900 sm:text-3xl">
            {t.project.relatedTemplate.replace('{category}', CATEGORIES[data.category][locale].toLowerCase())}
          </h2>
          <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <ProjectCard project={p} {locale} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-16 text-center lg:py-20">
    <div class="container-x">
      <h2 class="font-display text-3xl text-ink-900">{t.project.ctaHeading}</h2>
      <a href={withBase(`${prefix}/contact/`)} class="btn-primary mt-6">{t.project.ctaButton}</a>
    </div>
  </section>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.pswp-gallery',
    children: 'a',
    bgOpacity: 0.92,
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();
</script>
