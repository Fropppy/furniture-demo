---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Placeholder from '../Placeholder.astro';
import ProjectCard from '../ProjectCard.astro';
import { CATEGORIES, formatDate, withBase, type Locale } from '../../lib/site';
import { pick } from '../../lib/i18n';
import { UI } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const stats = [
  { value: '120+', label: t.home.statsLabels[0] },
  { value: '12', label: t.home.statsLabels[1] },
  { value: '30', label: t.home.statsLabels[2] },
  { value: '40k', label: t.home.statsLabels[3] },
];
const prefix = locale === 'vi' ? '/vi' : '';
---

<Base title={t.meta.home.title} description={t.meta.home.description} {locale}>
  <h1 class="sr-only">{t.home.srTitle}</h1>
  {
    featured.length > 0 && (
      <section class="relative -mt-16 lg:-mt-20" aria-label={t.home.featuredLabel}>
        <div class="swiper hero-swiper h-[88vh] min-h-[540px]" data-a11y-message={t.home.featuredLabel}>
          <div class="swiper-wrapper">
            {featured.map((p, i) => (
              <div class="swiper-slide relative overflow-hidden">
                {
                  p.data.cover ? (
                    <Image
                      src={p.data.cover.image}
                      alt={p.data.cover.alt}
                      layout="full-width"
                      // Only the first paint is the LCP; later slides load
                      // eagerly anyway (fade effect) but stay off the
                      // priority lane.
                      priority={i === 0}
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  ) : (
                    <Placeholder
                      scene={p.data.scene}
                      hue={p.data.hue}
                      alt={locale === 'vi' ? `${pick(locale, p.data.title, p.data.titleVi)} — ${t.home.heroAltSuffix}` : `${p.data.title} — ${t.home.heroAltSuffix}`}
                      class="absolute inset-0 h-full w-full"
                    />
                  )
                }
                <div class="absolute inset-0 bg-gradient-to-t from-ink-900/75 via-ink-900/25 to-ink-900/10" />
                <div class="container-x absolute inset-x-0 bottom-0 pb-14 sm:pb-20">
                  <p class="text-xs font-semibold tracking-[0.22em] text-cream-200/90 uppercase">
                    {CATEGORIES[p.data.category][locale]} · {p.data.year}
                  </p>
                  <p class="mt-3 max-w-3xl font-display text-4xl leading-tight text-cream-50 sm:text-5xl lg:text-6xl">
                    {pick(locale, p.data.title, p.data.titleVi)}
                  </p>
                  <p class="mt-3 text-sm text-cream-200/85 sm:text-base">
                    {pick(locale, p.data.location, p.data.locationVi)} · {p.data.area} m² · {p.data.style}
                  </p>
                  <a href={withBase(`${prefix}/projects/${p.id}/`)} class="btn-light mt-7">
                    {t.home.viewProject}
                  </a>
                </div>
              </div>
            ))}
          </div>
          <div class="hero-pagination"></div>
        </div>
        <button
          id="hero-pause"
          type="button"
          data-label-pause={t.home.pause}
          data-label-play={t.home.play}
          class="absolute bottom-5 left-5 z-10 grid h-11 w-11 place-items-center rounded-full border border-cream-50/30 bg-ink-900/40 text-cream-50 backdrop-blur-sm transition-colors hover:bg-ink-900/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream-50 sm:bottom-8 sm:left-8"
          aria-label={t.home.pause}
        >
          <svg class="icon-pause h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <rect x="3" y="2" width="3.5" height="12" rx="1" />
            <rect x="9.5" y="2" width="3.5" height="12" rx="1" />
          </svg>
          <svg class="icon-play hidden h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M4 2.5v11l9-5.5-9-5.5z" />
          </svg>
        </button>
      </section>
    )
  }

  <!-- Stats -->
  <section class="bg-ink-900 text-cream-50">
    <div class="container-x grid grid-cols-2 gap-y-10 py-14 text-center sm:py-16 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div>
            <p class="font-display text-4xl text-clay-300 sm:text-5xl">{s.value}</p>
            <p class="mt-2 text-xs font-medium tracking-[0.18em] text-cream-200/60 uppercase">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Featured work -->
  <section class="py-20 lg:py-28">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="reveal max-w-xl">
          <p class="eyebrow">{t.home.selectedWork}</p>
          <h2 class="mt-3 font-display text-3xl text-ink-900 sm:text-4xl lg:text-5xl">
            {t.home.proudHeading}
          </h2>
        </div>
        <a href={withBase(`${prefix}/projects/`)} class="btn-ghost reveal">{t.home.allProjects}</a>
      </div>

      <div class="mt-10 flex flex-wrap gap-2 reveal" role="group" aria-label={t.home.filterGroup}>
        <button class="work-tab btn bg-ink-900 text-cream-50" data-filter="all">{t.home.all}</button>
        {
          Object.entries(CATEGORIES).map(([key, labels]) => (
            <button class="work-tab btn border border-ink-800/15 text-ink-700 hover:border-ink-800/40" data-filter={key}>
              {labels[locale]}
            </button>
          ))
        }
      </div>

      <div id="work-grid" class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} {locale} />)}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-cream-100 py-20 lg:py-28">
    <div class="container-x">
      <div class="reveal max-w-xl">
        <p class="eyebrow">{t.home.servicesEyebrow}</p>
        <h2 class="mt-3 font-display text-3xl text-ink-900 sm:text-4xl lg:text-5xl">
          {t.home.servicesHeading}
        </h2>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.home.services.map((s, i) => (
            <div class="reveal rounded-xl border border-ink-900/8 bg-cream-50 p-7" style={`--reveal-delay:${i * 80}ms`}>
              <p class="font-display text-lg text-clay-600">0{i + 1}</p>
              <h3 class="mt-3 font-display text-xl text-ink-900">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-600">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 lg:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_2fr]">
      <div class="reveal">
        <p class="eyebrow">{t.home.processEyebrow}</p>
        <h2 class="mt-3 font-display text-3xl text-ink-900 sm:text-4xl">
          {t.home.processHeading}
        </h2>
        <p class="mt-5 text-ink-600">{t.home.processIntro}</p>
      </div>
      <ol class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
        {
          t.home.process.map((p, i) => (
            <li class="reveal border-t-2 border-clay-600/60 pt-5" style={`--reveal-delay:${i * 80}ms`}>
              <p class="text-xs font-semibold tracking-[0.2em] text-clay-600">{p.step}</p>
              <h3 class="mt-2 font-display text-xl text-ink-900">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Journal teaser -->
  <section class="bg-cream-100 py-20 lg:py-28">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="reveal">
          <p class="eyebrow">{t.home.journalEyebrow}</p>
          <h2 class="mt-3 font-display text-3xl text-ink-900 sm:text-4xl">{t.home.journalHeading}</h2>
        </div>
        <a href={withBase(`${prefix}/journal/`)} class="btn-ghost reveal">{t.home.allArticles}</a>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {
          posts.slice(0, 3).map((post, i) => (
              <a href={withBase(`${prefix}/journal/${post.id}/`)} class="reveal group" style={`--reveal-delay:${i * 80}ms`}>
              <p class="text-xs font-semibold tracking-[0.18em] text-clay-600 uppercase">
                {post.data.tag} · {formatDate(post.data.date, locale)}
              </p>
              <h3 class="mt-2 font-display text-xl text-ink-900 group-hover:text-clay-600">
                {pick(locale, post.data.title, post.data.titleVi)}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{pick(locale, post.data.excerpt, post.data.excerptVi)}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-ink-900 py-20 text-center lg:py-24">
    <div class="container-x reveal max-w-2xl">
      <h2 class="font-display text-3xl text-cream-50 sm:text-4xl lg:text-5xl">
        {t.home.ctaHeading}
      </h2>
      <p class="mt-4 text-cream-200/75">{t.home.ctaText}</p>
      <a href={withBase(`${prefix}/contact/`)} class="btn-primary mt-8">{t.home.ctaButton}</a>
    </div>
  </section>
</Base>

<script>
  import Swiper from 'swiper';
  import { A11y, Autoplay, EffectFade, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-fade';
  import 'swiper/css/pagination';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const swiper = new Swiper('.hero-swiper', {
    modules: [A11y, Autoplay, EffectFade, Pagination],
    effect: 'fade',
    fadeEffect: { crossFade: true },
    loop: true,
    speed: prefersReducedMotion ? 0 : 900,
    autoplay: { delay: 6000, disableOnInteraction: false },
    pagination: { el: '.hero-pagination', clickable: true, bulletElement: 'button' },
    a11y: { containerMessage: document.querySelector<HTMLElement>('.hero-swiper')?.getAttribute('data-a11y-message') ?? 'Featured projects slideshow' },
  });

  // WCAG 2.2.2: autoplay must be pausable by the user, and never starts
  // automatically for reduced-motion users. The button toggles it either way.
  const pauseBtn = document.getElementById('hero-pause');
  const setPaused = (paused: boolean) => {
    if (paused) swiper.autoplay.stop();
    else swiper.autoplay.start();
    const label = paused ? pauseBtn?.dataset.labelPlay : pauseBtn?.dataset.labelPause;
    if (label) pauseBtn?.setAttribute('aria-label', label);
    pauseBtn?.querySelector('.icon-pause')?.classList.toggle('hidden', paused);
    pauseBtn?.querySelector('.icon-play')?.classList.toggle('hidden', !paused);
  };
  if (prefersReducedMotion) setPaused(true);
  pauseBtn?.addEventListener('click', () => setPaused(swiper.autoplay.running));

  // Home "Selected work" category filter
  const tabs = document.querySelectorAll<HTMLButtonElement>('.work-tab');
  const cards = document.querySelectorAll<HTMLElement>('#work-grid [data-category]');
  const activeCls = ['bg-ink-900', 'text-cream-50'];
  const idleCls = ['border', 'border-ink-800/15', 'text-ink-700', 'hover:border-ink-800/40'];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter;
      tabs.forEach((t) => {
        t.classList.remove(...activeCls);
        t.classList.add(...idleCls);
        t.setAttribute('aria-pressed', String(t === tab));
      });
      tab.classList.remove(...idleCls);
      tab.classList.add(...activeCls);
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
