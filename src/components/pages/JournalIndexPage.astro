---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import { formatDate, withBase, type Locale } from '../../lib/site';
import { pick } from '../../lib/i18n';
import { UI } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI[locale];
const prefix = locale === 'vi' ? '/vi' : '';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title={t.meta.journal.title} description={t.meta.journal.description} {locale}>
  <PageHeader eyebrow={t.home.journalEyebrow} title={t.home.journalHeading} />

  <section class="py-16 lg:py-24">
    <div class="container-x">
      <div class="mx-auto grid max-w-3xl gap-12">
        {
          posts.map((post) => (
            <article class="reveal border-b border-ink-900/8 pb-12">
              <p class="text-xs font-semibold tracking-[0.18em] text-clay-600 uppercase">
                {post.data.tag} · {formatDate(post.data.date, locale)}
              </p>
              <h2 class="mt-2 font-display text-2xl text-ink-900 sm:text-3xl">
                <a href={withBase(`${prefix}/journal/${post.id}/`)} class="transition-colors hover:text-clay-600">
                  {pick(locale, post.data.title, post.data.titleVi)}
                </a>
              </h2>
              <p class="mt-3 leading-relaxed text-ink-600">{pick(locale, post.data.excerpt, post.data.excerptVi)}</p>
              <a href={withBase(`${prefix}/journal/${post.id}/`)} class="mt-4 inline-block text-sm font-semibold text-clay-600 hover:text-clay-700">
                {t.journal.readArticle}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>
