---
import { SITE, CATEGORIES, withBase, type Locale } from '../lib/site';
import { UI } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = UI[locale];
const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-cream-200">
  <div class="container-x grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-4 lg:py-20">
    <div>
      <p class="font-display text-2xl font-semibold text-cream-50">
        FORMA<span class="text-clay-400">.</span>
      </p>
      <p class="mt-4 text-sm leading-relaxed text-cream-200/70">
        {t.meta.home.description}
      </p>
      <div class="mt-6 flex gap-4 text-sm">
        {
          Object.entries(SITE.social).map(([name, href]) => (
            <a
              href={href}
              rel="noopener noreferrer"
              target="_blank"
              class="capitalize text-cream-200/70 transition-colors hover:text-clay-300"
            >
              {name}
            </a>
          ))
        }
      </div>
    </div>

    <nav aria-label={t.footer.explore}>
      <p class="text-xs font-semibold tracking-[0.2em] text-clay-300 uppercase">{t.footer.explore}</p>
      <ul class="mt-5 space-y-3 text-sm">
        <li><a class="text-cream-200/70 hover:text-cream-50" href={withBase('/projects/')}>{t.footer.allProjects}</a></li>
        <li><a class="text-cream-200/70 hover:text-cream-50" href={withBase('/about/')}>{t.nav.studio}</a></li>
        <li><a class="text-cream-200/70 hover:text-cream-50" href={withBase('/journal/')}>{t.nav.journal}</a></li>
        <li><a class="text-cream-200/70 hover:text-cream-50" href={withBase('/contact/')}>{t.nav.contact}</a></li>
      </ul>
    </nav>

    <nav aria-label={t.footer.practice}>
      <p class="text-xs font-semibold tracking-[0.2em] text-clay-300 uppercase">{t.footer.practice}</p>
      <ul class="mt-5 space-y-3 text-sm">
        {
          Object.entries(CATEGORIES).map(([key, labels]) => (
            <li>
              <a class="text-cream-200/70 hover:text-cream-50" href={withBase(`/projects/?category=${key}`)}>
                {labels[locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="text-xs font-semibold tracking-[0.2em] text-clay-300 uppercase">{t.footer.contact}</p>
      <ul class="mt-5 space-y-3 text-sm text-cream-200/70">
        <li>{SITE.address}</li>
        <li>
          <a class="hover:text-cream-50" href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>
        </li>
        <li>
          <a class="hover:text-cream-50" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>{t.footer.hours}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-cream-50/10">
    <div
      class="container-x flex flex-col items-center justify-between gap-3 py-6 text-xs text-cream-200/50 sm:flex-row"
    >
      <p>© {year} {SITE.name}. {t.footer.rights}</p>
      <p>{t.footer.byline}</p>
    </div>
  </div>
</footer>
