---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Journal"
  description="Notes from the FORMA Studio practice — materials, process and lessons from delivered projects."
>
  <section class="border-b border-ink-900/8 bg-cream-100">
    <div class="container-x py-14 lg:py-20">
      <p class="eyebrow reveal">Journal</p>
      <h1 class="reveal mt-3 font-display text-4xl text-ink-900 sm:text-5xl lg:text-6xl">
        Notes from the studio
      </h1>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="container-x">
      <div class="mx-auto grid max-w-3xl gap-12">
        {
          posts.map((post) => (
            <article class="reveal border-b border-ink-900/8 pb-12">
              <p class="text-xs font-semibold tracking-[0.18em] text-clay-600 uppercase">
                {post.data.tag} · {fmt(post.data.date)}
              </p>
              <h2 class="mt-2 font-display text-2xl text-ink-900 sm:text-3xl">
                <a href={`/journal/${post.id}/`} class="transition-colors hover:text-clay-600">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 leading-relaxed text-ink-600">{post.data.excerpt}</p>
              <a href={`/journal/${post.id}/`} class="mt-4 inline-block text-sm font-semibold text-clay-600 hover:text-clay-700">
                Read article →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>
