---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { CATEGORIES, SITE } from '../lib/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const services = [
  {
    title: 'Interior architecture',
    text: 'Concept to construction drawings — plans, lighting, materials and joinery detail resolved before anything is built.',
  },
  {
    title: 'Furniture & joinery',
    text: 'Bespoke pieces designed, prototyped and produced in our partner workshop, from a single table to full casegoods.',
  },
  {
    title: 'Design–build fit-out',
    text: 'Turnkey delivery with one team responsible for design intent, cost and schedule through to handover.',
  },
  {
    title: 'Feasibility & consulting',
    text: 'Layout, budget and concept testing for investors before a lease is signed — so decisions are made on numbers.',
  },
];

const process = [
  { step: '01', title: 'Discover', text: 'Site survey, listening, and a brief that records what success means for your project.' },
  { step: '02', title: 'Design', text: 'Concept, then developed design — 3D views, material boards and a priced furniture list.' },
  { step: '03', title: 'Build', text: 'Technical drawings, workshop production and on-site supervision by our own team.' },
  { step: '04', title: 'Hand over', text: 'Styling, snagging and a maintenance file. We stay reachable after the ribbon is cut.' },
];

const stats = [
  { value: '120+', label: 'Projects delivered' },
  { value: '12', label: 'Years of practice' },
  { value: '30', label: 'Designers & makers' },
  { value: '40k', label: 'm² fitted out' },
];
---

<Base title={`${SITE.name} — ${SITE.tagline}`}>
  <!-- Hero slider -->
  <section class="relative -mt-16 lg:-mt-20" aria-label="Featured projects">
    <div class="swiper hero-swiper h-[88vh] min-h-[540px]">
      <div class="swiper-wrapper">
        {
          featured.map((p) => (
            <div class="swiper-slide relative overflow-hidden">
              <Placeholder
                scene={p.data.scene}
                hue={p.data.hue}
                alt={`${p.data.title} — hero image`}
                class="absolute inset-0 h-full w-full"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-900/75 via-ink-900/25 to-ink-900/10" />
              <div class="container-x absolute inset-x-0 bottom-0 pb-14 sm:pb-20">
                <p class="text-xs font-semibold tracking-[0.22em] text-cream-200/90 uppercase">
                  {CATEGORIES[p.data.category]} · {p.data.year}
                </p>
                <h1 class="mt-3 max-w-3xl font-display text-4xl leading-tight text-cream-50 sm:text-5xl lg:text-6xl">
                  {p.data.title}
                </h1>
                <p class="mt-3 text-sm text-cream-200/85 sm:text-base">
                  {p.data.location} · {p.data.area} m² · {p.data.style}
                </p>
                <a href={`/projects/${p.id}/`} class="btn-light mt-7">
                  View project
                </a>
              </div>
            </div>
          ))
        }
      </div>
      <div class="hero-pagination"></div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-ink-900 text-cream-50">
    <div class="container-x grid grid-cols-2 gap-y-10 py-14 text-center sm:py-16 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div>
            <p class="font-display text-4xl text-clay-300 sm:text-5xl">{s.value}</p>
            <p class="mt-2 text-xs font-medium tracking-[0.18em] text-cream-200/60 uppercase">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Featured work -->
  <section class="py-20 lg:py-28">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="reveal max-w-xl">
          <p class="eyebrow">Selected work</p>
          <h2 class="mt-3 font-display text-3xl text-ink-900 sm:text-4xl lg:text-5xl">
            Projects we're proud to sign
          </h2>
        </div>
        <a href="/projects/" class="btn-ghost reveal">All projects →</a>
      </div>

      <div class="mt-10 flex flex-wrap gap-2 reveal" role="tablist" aria-label="Filter by category">
        <button class="work-tab btn bg-ink-900 text-cream-50" data-filter="all">All</button>
        {
          Object.entries(CATEGORIES).map(([key, label]) => (
            <button class="work-tab btn border border-ink-800/15 text-ink-700 hover:border-ink-800/40" data-filter={key}>
              {label}
            </button>
          ))
        }
      </div>

      <div id="work-grid" class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-cream-100 py-20 lg:py-28">
    <div class="container-x">
      <div class="reveal max-w-xl">
        <p class="eyebrow">What we do</p>
        <h2 class="mt-3 font-display text-3xl text-ink-900 sm:text-4xl lg:text-5xl">
          From first sketch to final styling
        </h2>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s, i) => (
            <div class="reveal rounded-xl border border-ink-900/8 bg-cream-50 p-7" style={`--reveal-delay:${i * 80}ms`}>
              <p class="font-display text-lg text-clay-600">0{i + 1}</p>
              <h3 class="mt-3 font-display text-xl text-ink-900">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-600">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 lg:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_2fr]">
      <div class="reveal">
        <p class="eyebrow">How we work</p>
        <h2 class="mt-3 font-display text-3xl text-ink-900 sm:text-4xl">
          A process built for trust
        </h2>
        <p class="mt-5 text-ink-600">
          Most of our clients are investing in a space for the first time. The process is
          transparent on purpose — you always know what happens next, what it costs, and
          who is accountable.
        </p>
      </div>
      <ol class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
        {
          process.map((p, i) => (
            <li class="reveal border-t-2 border-clay-600/60 pt-5" style={`--reveal-delay:${i * 80}ms`}>
              <p class="text-xs font-semibold tracking-[0.2em] text-clay-600">{p.step}</p>
              <h3 class="mt-2 font-display text-xl text-ink-900">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Journal teaser -->
  <section class="bg-cream-100 py-20 lg:py-28">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="reveal">
          <p class="eyebrow">Journal</p>
          <h2 class="mt-3 font-display text-3xl text-ink-900 sm:text-4xl">Notes from the studio</h2>
        </div>
        <a href="/journal/" class="btn-ghost reveal">All articles →</a>
      </div>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {
          posts.slice(0, 3).map((post, i) => (
            <a href={`/journal/${post.id}/`} class="reveal group" style={`--reveal-delay:${i * 80}ms`}>
              <p class="text-xs font-semibold tracking-[0.18em] text-clay-600 uppercase">
                {post.data.tag} · {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </p>
              <h3 class="mt-2 font-display text-xl text-ink-900 group-hover:text-clay-600">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{post.data.excerpt}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-ink-900 py-20 text-center lg:py-24">
    <div class="container-x reveal max-w-2xl">
      <h2 class="font-display text-3xl text-cream-50 sm:text-4xl lg:text-5xl">
        Have a space in mind?
      </h2>
      <p class="mt-4 text-cream-200/75">
        Tell us about the site, the budget and the timeline. We'll tell you honestly what's
        possible — usually within two working days.
      </p>
      <a href="/contact/" class="btn-primary mt-8">Start a project</a>
    </div>
  </section>
</Base>

<script>
  import Swiper from 'swiper';
  import { Autoplay, EffectFade, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/effect-fade';
  import 'swiper/css/pagination';

  new Swiper('.hero-swiper', {
    modules: [Autoplay, EffectFade, Pagination],
    effect: 'fade',
    fadeEffect: { crossFade: true },
    loop: true,
    speed: 900,
    autoplay: { delay: 6000, disableOnInteraction: false },
    pagination: { el: '.hero-pagination', clickable: true },
  });

  // Home "Selected work" tabs
  const tabs = document.querySelectorAll<HTMLButtonElement>('.work-tab');
  const cards = document.querySelectorAll<HTMLElement>('#work-grid [data-category]');
  const activeCls = ['bg-ink-900', 'text-cream-50'];
  const idleCls = ['border', 'border-ink-800/15', 'text-ink-700', 'hover:border-ink-800/40'];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter;
      tabs.forEach((t) => {
        t.classList.remove(...activeCls);
        t.classList.add(...idleCls);
      });
      tab.classList.remove(...idleCls);
      tab.classList.add(...activeCls);
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
