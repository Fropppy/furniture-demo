---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { placeholderDataUri } from '../../lib/placeholders';
import { CATEGORIES, SITE, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
      related: projects.filter((p) => p.id !== project.id && p.data.category === project.data.category).slice(0, 3),
    },
  }));
}

const { project, prev, next, related } = Astro.props;
const { data } = project;
const { Content } = await render(project);

let uidCounter = 0;
const galleryItems = data.gallery.map((scene) => ({
  scene,
  uri: placeholderDataUri(scene, data.hue, `d${++uidCounter}`),
}));

const meta = [
  ['Client', data.client],
  ['Location', data.location],
  ['Floor area', `${data.area} m²`],
  ['Style', data.style],
  ['Year', String(data.year)],
  ['Services', data.services.join(', ')],
  ...(data.budget ? [['Investment', data.budget]] : []),
] as [string, string][];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(withBase('/'), Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL(withBase('/projects/'), Astro.site) },
    { '@type': 'ListItem', position: 3, name: data.title },
  ],
};

const workSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  name: data.title,
  description: data.summary,
  datePublished: String(data.year),
  locationCreated: data.location,
  author: { '@type': 'Organization', name: SITE.name },
};
---

<Base title={data.title} description={data.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="seo" />
  <script type="application/ld+json" set:html={JSON.stringify(workSchema)} slot="seo" />

  <article class="py-12 lg:py-16">
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={withBase('/')} class="hover:text-clay-600">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={withBase('/projects/')} class="hover:text-clay-600">Projects</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-800">{data.title}</li>
        </ol>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[2fr_1fr] lg:items-end">
        <div>
          <p class="eyebrow reveal">
            {CATEGORIES[data.category]} · {data.year}
          </p>
          <h1 class="reveal mt-3 font-display text-4xl text-ink-900 sm:text-5xl lg:text-6xl">
            {data.title}
          </h1>
          <p class="reveal mt-5 max-w-2xl text-lg text-ink-600">{data.summary}</p>
        </div>
        <dl class="reveal grid grid-cols-2 gap-x-6 gap-y-4 border-t border-ink-900/10 pt-6 text-sm lg:border-t-0 lg:pt-0">
          {
            meta.map(([label, value]) => (
              <div>
                <dt class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">
                  {label}
                </dt>
                <dd class="mt-1 text-ink-800">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Photo gallery -->
      <section class="mt-14" aria-label="Project photo gallery">
        <div class="pswp-gallery grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
          {
            galleryItems.map((item, i) => (
              <a
                href={item.uri}
                class:list={[
                  'group block overflow-hidden rounded-xl bg-cream-100',
                  i % 5 === 0 ? 'lg:col-span-2 lg:row-span-2' : '',
                ]}
                data-pswp-width="1600"
                data-pswp-height="1200"
                aria-label={`Open photo ${i + 1} of ${data.title}`}
              >
                <div class:list={['overflow-hidden', i % 5 === 0 ? 'aspect-square lg:aspect-auto lg:h-full' : 'aspect-[4/3]']}>
                  <Placeholder
                    scene={item.scene}
                    hue={data.hue}
                    alt={`${data.title} — photo ${i + 1}`}
                    class="h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                  />
                </div>
              </a>
            ))
          }
        </div>
        <p class="mt-4 text-center text-xs text-ink-400">
          Placeholder illustrations — click any image to open the lightbox. Real project
          photography drops into the same slots.
        </p>
      </section>

      <!-- Write-up -->
      <div class="mx-auto mt-16 max-w-3xl">
        <div class="prose-brand">
          <Content />
        </div>
      </div>

      <!-- Prev / next -->
      <nav class="mt-20 grid gap-4 border-t border-ink-900/10 pt-8 sm:grid-cols-2" aria-label="More projects">
        {
          prev ? (
              <a href={withBase(`/projects/${prev.id}/`)} class="group">
              <p class="text-xs tracking-[0.18em] text-ink-500 uppercase">← Previous</p>
              <p class="mt-1 font-display text-xl text-ink-900 group-hover:text-clay-600">
                {prev.data.title}
              </p>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={withBase(`/projects/${next.id}/`)} class="group sm:text-right">
              <p class="text-xs tracking-[0.18em] text-ink-500 uppercase">Next →</p>
              <p class="mt-1 font-display text-xl text-ink-900 group-hover:text-clay-600">
                {next.data.title}
              </p>
            </a>
          )
        }
      </nav>
    </div>
  </article>

  <!-- Related -->
  {
    related.length > 0 && (
      <section class="bg-cream-100 py-16 lg:py-20">
        <div class="container-x">
          <h2 class="font-display text-2xl text-ink-900 sm:text-3xl">
            More {CATEGORIES[data.category].toLowerCase()} projects
          </h2>
          <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-16 text-center lg:py-20">
    <div class="container-x">
      <h2 class="font-display text-3xl text-ink-900">Planning something similar?</h2>
      <a href={withBase('/contact/')} class="btn-primary mt-6">Talk to our team</a>
    </div>
  </section>
</Base>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.pswp-gallery',
    children: 'a',
    bgOpacity: 0.92,
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();
</script>
