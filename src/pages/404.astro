---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';
---

<Base title="Page not found" noIndex>
  <section class="flex min-h-[60vh] items-center justify-center py-20 text-center">
    <div class="container-x max-w-xl">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-display text-4xl text-ink-900 sm:text-5xl">
        This page has moved out
      </h1>
      <p class="mt-4 text-ink-600">
        The page you're looking for doesn't exist — but plenty of finished rooms do.
      </p>
      <a href={withBase('/projects/')} class="btn-primary mt-8">Browse projects</a>
    </div>
  </section>
</Base>
