---
import Base from '../layouts/Base.astro';
import { withBase, DEFAULT_LOCALE } from '../lib/site';
import { UI } from '../lib/i18n';

// Single 404 for the whole static host (GitHub Pages serves one 404.html for
// every path) — bilingual by design so it works for both locales.
const t = UI[DEFAULT_LOCALE];
const tvi = UI.vi;
---

<Base title={t.meta.notFound.title} noIndex>
  <section class="flex min-h-[60vh] items-center justify-center py-20 text-center">
    <div class="container-x max-w-xl">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-display text-4xl text-ink-900 sm:text-5xl">
        {t.notFound.h1}
      </h1>
      <p class="mt-4 text-ink-600">{t.notFound.text}</p>
      <p class="mt-1 text-sm text-ink-500">{tvi.notFound.text}</p>
      <a href={withBase('/projects/')} class="btn-primary mt-8">{t.notFound.cta}</a>
    </div>
  </section>
</Base>
