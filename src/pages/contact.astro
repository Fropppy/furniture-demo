---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { FORM, SITE } from '../lib/site';
---

<Base
  title="Contact"
  description="Start a project with FORMA Studio — tell us about your site, budget and timeline, and we'll respond within two working days."
>
  <PageHeader
    eyebrow="Contact"
    title="Let's talk about your space"
    lede="A few lines about the site and what you're planning is enough to start. We reply to every enquiry within two working days."
  />

  <section class="py-16 lg:py-24">
    <div class="container-x grid gap-14 lg:grid-cols-[3fr_2fr]">
      <!-- Form -->
      <div class="reveal">
        <form
          id="contact-form"
          class="grid gap-5 sm:grid-cols-2"
          data-configured={FORM.accessKey ? 'true' : 'false'}
          data-endpoint={FORM.endpoint}
          data-fallback-email={SITE.email}
          data-fallback-phone={SITE.phone}
          novalidate
        >
          <input type="hidden" name="access_key" value={FORM.accessKey} />
          <input type="hidden" name="subject" value={FORM.subject} />
          <input type="hidden" name="from_name" value={FORM.fromName} />
          <!-- Honeypot: bots tick visible checkboxes; humans never see this one -->
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

          <label class="block">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-600 uppercase">Name *</span>
            <input required name="name" type="text" autocomplete="name"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-hidden focus:ring-2 focus:ring-clay-500/30" />
          </label>
          <label class="block">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-600 uppercase">Phone / Zalo *</span>
            <input required name="phone" type="tel" autocomplete="tel"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-hidden focus:ring-2 focus:ring-clay-500/30" />
          </label>
          <label class="block sm:col-span-2">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-600 uppercase">Email</span>
            <input name="email" type="email" autocomplete="email"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-hidden focus:ring-2 focus:ring-clay-500/30" />
          </label>
          <label class="block">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-600 uppercase">Project type</span>
            <select name="type"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-hidden focus:ring-2 focus:ring-clay-500/30">
              <option>Residential</option>
              <option>Café / restaurant / bar</option>
              <option>Hotel / homestay</option>
              <option>Office</option>
              <option>Retail</option>
              <option>Other</option>
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-600 uppercase">Budget range</span>
            <select name="budget"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-hidden focus:ring-2 focus:ring-clay-500/30">
              <option>Under 1 billion VND</option>
              <option>1 – 3 billion VND</option>
              <option>3 – 7 billion VND</option>
              <option>7 – 15 billion VND</option>
              <option>Over 15 billion VND</option>
              <option>Not sure yet</option>
            </select>
          </label>
          <label class="block sm:col-span-2">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-600 uppercase">About the project *</span>
            <textarea required name="message" rows="5" placeholder="Location, floor area, current state of the site, timeline…"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-hidden focus:ring-2 focus:ring-clay-500/30"></textarea>
          </label>
          <label class="flex items-start gap-3 sm:col-span-2">
            <input required type="checkbox" name="consent"
              class="mt-0.5 h-4 w-4 rounded border-ink-900/25 accent-clay-600" />
            <span class="text-sm text-ink-600">
              I agree to be contacted about this enquiry. My details are used only to
              respond and are never shared. *
            </span>
          </label>
          <div class="sm:col-span-2">
            <button type="submit" id="form-submit" class="btn-primary w-full sm:w-auto">Send enquiry</button>
            <p id="form-note" role="status" class="mt-3 hidden text-sm"></p>
          </div>
        </form>
      </div>

      <!-- Details -->
      <aside class="reveal space-y-8">
        <div>
          <h2 class="font-display text-2xl text-ink-900">Studio</h2>
          <p class="mt-3 text-ink-600">{SITE.address}</p>
          <p class="mt-1 text-ink-600">Mon – Sat, 8:30 – 18:00</p>
        </div>
        <div>
          <h2 class="font-display text-2xl text-ink-900">Direct</h2>
          <p class="mt-3">
            <a class="text-clay-600 hover:text-clay-700" href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>
          </p>
          <p>
            <a class="text-clay-600 hover:text-clay-700" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>
        <div class="rounded-xl bg-cream-100 p-6 text-sm leading-relaxed text-ink-600">
          <p class="font-semibold text-ink-900">Visiting?</p>
          <p class="mt-2">
            Our workshop and material library welcome clients on weekday afternoons —
            mention it in your message and we'll arrange a tour.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Submissions POST JSON to a Web3Forms-compatible endpoint and land in the
  // studio's admin inbox (access key is public-safe; set PUBLIC_FORM_ACCESS_KEY).
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const note = document.getElementById('form-note')!;
  const submitBtn = document.getElementById('form-submit') as HTMLButtonElement;
  const loadedAt = Date.now();

  const showNote = (message: string, isError: boolean) => {
    note.textContent = message;
    note.classList.remove('hidden');
    note.classList.toggle('text-ink-900', isError);
    note.classList.toggle('border-l-2', isError);
    note.classList.toggle('border-clay-600', isError);
    note.classList.toggle('pl-3', isError);
    note.classList.toggle('text-clay-700', !isError);
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (form.dataset.configured !== 'true') {
      showNote(
        `The form isn't configured yet — please email ${form.dataset.fallbackEmail} or call ${form.dataset.fallbackPhone} instead.`,
        true,
      );
      return;
    }

    // Time-trap: humans take longer than 3s to fill this in.
    if (Date.now() - loadedAt < 3000) {
      showNote('Your message was sent. Thank you.', false); // silently drop bots
      return;
    }

    const data = Object.fromEntries(new FormData(form).entries());

    submitBtn.disabled = true;
    submitBtn.setAttribute('aria-busy', 'true');
    submitBtn.textContent = 'Sending…';
    note.classList.add('hidden');

    try {
      const res = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (res.ok && json.success) {
        form.reset();
        showNote('Thank you — your enquiry is on its way. We reply within two working days.', false);
      } else {
        showNote('Something went wrong sending your message. Please try again, or email us directly.', true);
      }
    } catch {
      showNote('No connection — please check your network and try again, or email us directly.', true);
    } finally {
      submitBtn.disabled = false;
      submitBtn.removeAttribute('aria-busy');
      submitBtn.textContent = 'Send enquiry';
    }
  });

  // Client-side validation messaging with the built-in UI disabled above.
  form?.addEventListener('invalid', (e) => {
    const field = e.target as HTMLElement;
    field.setAttribute('aria-invalid', 'true');
    (field as HTMLInputElement | HTMLTextAreaElement).focus();
  }, true);
  form?.addEventListener('input', (e) => {
    const field = e.target as HTMLElement;
    if (field.matches(':valid')) field.removeAttribute('aria-invalid');
  }, true);
</script>
