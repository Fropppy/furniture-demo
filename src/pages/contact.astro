---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---

<Base
  title="Contact"
  description="Start a project with FORMA Studio — tell us about your site, budget and timeline, and we'll respond within two working days."
>
  <section class="border-b border-ink-900/8 bg-cream-100">
    <div class="container-x py-14 lg:py-20">
      <p class="eyebrow reveal">Contact</p>
      <h1 class="reveal mt-3 font-display text-4xl text-ink-900 sm:text-5xl lg:text-6xl">
        Let's talk about your space
      </h1>
      <p class="reveal mt-5 max-w-2xl text-lg text-ink-600">
        A few lines about the site and what you're planning is enough to start. We reply
        to every enquiry within two working days.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="container-x grid gap-14 lg:grid-cols-[3fr_2fr]">
      <!-- Form -->
      <div class="reveal">
        <form id="contact-form" class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">Name *</span>
            <input required name="name" type="text" autocomplete="name"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">Phone / Zalo *</span>
            <input required name="phone" type="tel" autocomplete="tel"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-none" />
          </label>
          <label class="block sm:col-span-2">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">Email</span>
            <input name="email" type="email" autocomplete="email"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">Project type</span>
            <select name="type"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-none">
              <option>Residential</option>
              <option>Café / restaurant / bar</option>
              <option>Hotel / homestay</option>
              <option>Office</option>
              <option>Retail</option>
              <option>Other</option>
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">Budget range</span>
            <select name="budget"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-none">
              <option>Under 1 billion VND</option>
              <option>1 – 3 billion VND</option>
              <option>3 – 7 billion VND</option>
              <option>7 – 15 billion VND</option>
              <option>Over 15 billion VND</option>
              <option>Not sure yet</option>
            </select>
          </label>
          <label class="block sm:col-span-2">
            <span class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">About the project *</span>
            <textarea required name="message" rows="5" placeholder="Location, floor area, current state of the site, timeline…"
              class="mt-1.5 w-full rounded-lg border border-ink-900/15 bg-cream-50 px-3 py-2.5 text-sm focus:border-clay-500 focus:outline-none"></textarea>
          </label>
          <div class="sm:col-span-2">
            <button type="submit" class="btn-primary w-full sm:w-auto">Send enquiry</button>
            <p id="form-note" class="mt-3 hidden text-sm text-clay-700"></p>
          </div>
        </form>
      </div>

      <!-- Details -->
      <aside class="reveal space-y-8">
        <div>
          <h2 class="font-display text-2xl text-ink-900">Studio</h2>
          <p class="mt-3 text-ink-600">{SITE.address}</p>
          <p class="mt-1 text-ink-600">Mon – Sat, 8:30 – 18:00</p>
        </div>
        <div>
          <h2 class="font-display text-2xl text-ink-900">Direct</h2>
          <p class="mt-3">
            <a class="text-clay-600 hover:text-clay-700" href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>
          </p>
          <p>
            <a class="text-clay-600 hover:text-clay-700" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>
        <div class="rounded-xl bg-cream-100 p-6 text-sm leading-relaxed text-ink-600">
          <p class="font-semibold text-ink-900">Visiting?</p>
          <p class="mt-2">
            Our workshop and material library welcome clients on weekday afternoons —
            mention it in your message and we'll arrange a tour.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Static-site stub: no backend is wired yet. Connect this handler to
  // Formspree / GetResponse / your API before launch — see README.
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const note = document.getElementById('form-note')!;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    note.textContent =
      'Thank you — this demo form is not connected to a backend yet. Please call or email us directly.';
    note.classList.remove('hidden');
  });
</script>
